---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('tulisan', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageTitle = "Orin.ai — hemat biaya & waktu pakai AI";
const pageDescription = "Orin.ai menulis panduan praktis, jujur, dan tervalidasi soal cara memakai AI agent secara hemat, untuk solo developer, UMKM digital, freelancer, dan agency kecil di Indonesia.";
---
<Base title={pageTitle} description={pageDescription}>
  <nav>
    <a href="/" class="brand"><img src="/images/logo-orin.svg" alt="Orin" height="28" style="display:block;height:28px;width:auto;" /></a>
    <div class="nav-links">
      <a href="/#tulisan">Tulisan</a>
      <a href="/#tentang">Tentang</a>
    </div>
  </nav>

  <section class="hero">
    <span class="eyebrow">Untuk pengguna AI di Indonesia</span>
    <h1 class="display">Pakai AI agent tanpa buang-buang biaya.</h1>
    <p class="subtitle">
      Orin.ai menulis panduan praktis, jujur, dan tervalidasi — bukan hype — soal cara
      memakai AI agent secara hemat, jelas, dan sesuai kebutuhan nyata: solo developer,
      UMKM digital, freelancer, sampai agency kecil.
    </p>
  </section>

  <section class="warm" id="tulisan">
    <div class="container">
      <h2 class="section-heading">Tulisan Terbaru</h2>
      <p class="section-sub">Setiap tulisan diverifikasi terhadap dokumentasi resmi sebelum ditulis. Klaim yang tidak bisa dibuktikan, tidak dimuat.</p>
      <div class="post-grid">
        {posts.map((post) => (
          <a class="post-card" href={`/tulisan/${post.id}`}>
            <span class="tag">{post.data.tag}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="subscribe" id="subscribe">
    <div class="container">
      <h2 class="section-heading">Dapatkan PDF Gratis: 10 Prompt Hemat Token</h2>
      <p class="section-sub">Kirim email kamu, langsung terima lead magnet + update artikel baru tiap minggu.</p>
      <form id="subscribe-form" class="subscribe-form" novalidate>
        <input type="email" id="subscribe-email" name="email" placeholder="email@contoh.com" required />
        <button type="submit" class="btn-primary">Kirim</button>
      </form>
      <p id="subscribe-msg" class="subscribe-msg" role="status" aria-live="polite"></p>
    </div>
  </section>

  <section id="tentang">
    <div class="container" style="padding: 112px 0; max-width: 720px;">
      <h2 class="section-heading">Tentang Orin.ai</h2>
      <p style="color: var(--text-secondary); font-size: 1.05rem; line-height: 1.7;">
        Orin.ai dibuat untuk pembaca Indonesia yang mulai pakai AI agent untuk kerja
        sehari-hari, tapi bingung soal biaya, setup, atau cara pakai yang efisien.
        Kami tidak menjual mimpi — setiap panduan diverifikasi terhadap sumber
        resmi sebelum dipublikasikan.
      </p>
    </div>
  </section>

  <footer>
    <p>Orin.ai — dibuat untuk pembaca Indonesia</p>
  </footer>
</Base>

<script>
  const form = document.getElementById('subscribe-form');
  const msg = document.getElementById('subscribe-msg');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('subscribe-email').value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        msg.textContent = 'Email tidak valid.';
        msg.className = 'subscribe-msg error';
        return;
      }
      msg.textContent = 'Mengirim...';
      msg.className = 'subscribe-msg';
      try {
        const res = await fetch('https://otomasi.nrds.web.id/webhook/orin-subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        if (res.ok) {
          msg.textContent = 'Terima kasih! Cek email kamu untuk PDF gratis.';
          msg.className = 'subscribe-msg success';
          form.reset();
        } else {
          msg.textContent = 'Gagal mengirim. Coba lagi nanti.';
          msg.className = 'subscribe-msg error';
        }
      } catch (err) {
        msg.textContent = 'Gagal mengirim. Coba lagi nanti.';
        msg.className = 'subscribe-msg error';
      }
    });
  }
</script>
